menu "Jim Tcl Extensions"

    config JIM_EXT_HTTP
        bool "Enable HTTP client extension"
        default y
        help
            Adds the [http] command for HTTP GET/POST/PUT/DELETE
            with synchronous and async (callback) modes.

    config JIM_EXT_WEBSOCKET
        bool "Enable WebSocket client extension"
        default n
        help
            Adds the [ws] command for WebSocket connections.
            Pulls in the esp_websocket_client managed component.

    config JIM_EXT_MQTT
        bool "Enable MQTT client extension"
        default y
        help
            Adds the [mqtt] command for MQTT publish/subscribe.

    config JIM_EXT_JSON
        bool "Enable JSON extension (cJSON)"
        default y
        help
            Adds the [json] command for encoding/decoding JSON using
            ESP-IDF's bundled cJSON library. Also enables -json flags
            in the HTTP, MQTT, and WebSocket extensions.

    config JIM_EXT_TWAI
        bool "Enable TWAI (CAN bus) extension"
        default n
        help
            Adds the [twai] command for CAN bus communication via the
            ESP32 TWAI controller. Only available on chips with TWAI
            hardware (SOC_TWAI_SUPPORTED).

    config JIM_EXT_SERIAL
        bool "Enable Serial (UART) extension"
        default y
        help
            Adds the [serial] command for UART serial port communication.
            Supports up to 3 UART ports with configurable baud rate,
            data bits, stop bits, parity, and async listener mode.

    config JIM_EXT_ADC
        bool "Enable ADC extension"
        default y
        help
            Adds the [adc] command for analog-to-digital conversion.

    config JIM_EXT_PWM
        bool "Enable PWM (LEDC) extension"
        default y
        help
            Adds the [pwm] command for pulse-width modulation via LEDC.

    config JIM_EXT_TIMER
        bool "Enable Timer extension"
        default y
        help
            Adds the [timer] command for software timers that fire
            callbacks to named tasks.

    config JIM_EXT_FS
        bool "Enable Filesystem (SPIFFS) extension"
        default y
        help
            Adds the [fs] command for SPIFFS filesystem access.

    config JIM_EXT_OTA
        bool "Enable OTA update extension"
        default y
        help
            Adds the [ota] command for over-the-air firmware updates.

    config JIM_EXT_SPI
        bool "Enable SPI master extension"
        default y
        help
            Adds the [spi] command for SPI bus communication.

    config JIM_EXT_ONEWIRE
        bool "Enable OneWire extension"
        default y
        help
            Adds the [onewire] command for 1-Wire bus devices (DS18B20, etc).

    config JIM_EXT_CRON
        bool "Enable Cron/scheduler extension"
        default y
        help
            Adds the [cron] command for periodic script execution via
            FreeRTOS timers delivering callbacks to tasks.

    config JIM_EXT_SYSLOG
        bool "Enable Syslog extension"
        default y
        help
            Adds the [syslog] command for UDP syslog (RFC 5424) output
            with optional puts redirect.

endmenu
