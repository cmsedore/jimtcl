# ctlplane.test -- Control plane extension tests
# Tests the Tcl command interface. Cannot test start/stop lifecycle because
# the console UART is used by the REPL; tests status, auth, and error cases.

test suite "Control Plane"
test reset

# --- Status ---

test run ctlplane-1.1 {status returns a dict} -body {
    set s [ctlplane status]
    expr {[llength $s] > 0}
} -result {1}

test run ctlplane-1.2 {status has running field} -body {
    set s [ctlplane status]
    dict exists $s running
} -result {1}

test run ctlplane-1.3 {status shows not running by default} -body {
    set s [ctlplane status]
    dict get $s running
} -result {0}

test run ctlplane-1.4 {status has transport field} -body {
    set s [ctlplane status]
    dict exists $s transport
} -result {1}

test run ctlplane-1.5 {status has auth_required field} -body {
    set s [ctlplane status]
    dict exists $s auth_required
} -result {1}

test run ctlplane-1.6 {status has authenticated field} -body {
    set s [ctlplane status]
    dict exists $s authenticated
} -result {1}

# --- Error cases ---

test run ctlplane-2.1 {stop when not running} -body {
    ctlplane stop
} -returnCodes error -match glob -result {*not running*}

test run ctlplane-2.2 {start with unsupported transport} -body {
    ctlplane start bluetooth
} -returnCodes error -match glob -result {*unsupported transport*}

test run ctlplane-2.3 {auth with no key configured returns ok} -body {
    ctlplane auth testkey
} -result {auth not required}

test report
