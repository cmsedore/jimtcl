# Jim Tcl ESP32 default SDK configuration

# Increase main task stack size for Tcl interpreter
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Enable UART console
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Enable VFS for file I/O support
CONFIG_VFS_SUPPORT_IO=y

# Enable NVS for persistent storage
CONFIG_NVS_ENCRYPTION=n

# Enable WiFi
CONFIG_ESP_WIFI_ENABLED=y

# Partition table - use custom to include storage partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 4MB flash (standard on most dev boards)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Enable certificate bundle for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Enable FreeRTOS stats for task monitoring
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
